# Capgemini Generative Engine API Configuration
CAPGEMINI_API_KEY=your_api_key_here
CAPGEMINI_API_URL=wss://ws.generative.engine.capgemini.com/

# Application Settings
DEBUG=True
PORT=5000
UPLOAD_FOLDER=./uploads
MAX_FILE_SIZE=10485760

# Model Settings
MAX_TOKENS=2000
TEMPERATURE=0.7
CHUNK_SIZE=2000

# Vector Search Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2