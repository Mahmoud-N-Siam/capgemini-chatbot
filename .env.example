# Capgemini Generative Engine API Configuration
# Copy this file to .env and fill in real values. Never commit .env.
CAPGEMINI_API_KEY=your_api_key_here
CAPGEMINI_API_URL=wss://ws.generative.engine.capgemini.com/
OPENAI_API_URL=https://openai.generative.engine.capgemini.com/v1

# Model Configuration
MODEL_NAME=us.anthropic.claude-sonnet-4-5-20250929-v1:0
MODEL_PROVIDER=bedrock
MODEL_INTERFACE=multimodal
MODEL_ADAPTER_VERSION=v2

# Application Settings
DEBUG=False
SECRET_KEY=replace_with_a_long_random_secret
PORT=5000
UPLOAD_FOLDER=./uploads
MAX_FILE_SIZE=10485760
API_TIMEOUT=60
WEB_SEARCH_ENABLED=false
WEB_SEARCH_TIMEOUT=8
WEB_SEARCH_MAX_RESULTS=5

# Model Settings
MAX_TOKENS=4096
TEMPERATURE=0.7
TOP_P=0.9
STREAMING=true

# Optional RAG Settings
WORKSPACE_ID=
DOC_LIMIT=3

# Chunk Settings
CHUNK_SIZE=2000

# Embeddings Configuration
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_TIMEOUT=30
EMBEDDING_BATCH_SIZE=16

# Retrieval Settings
SEARCH_TOP_K=3
SEARCH_THRESHOLD=0.5
MAX_HISTORY_MESSAGES=20
